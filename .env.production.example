KIU_ENVIRONMENT=production
NODE_ENV=production

KIU_REALTIME_HOST=0.0.0.0
KIU_REALTIME_PORT=48933
KIU_PUBLIC_APP_URL=https://portal.kiu.edu.ge
KIU_PUBLIC_BACKEND_URL=https://portal-api.kiu.edu.ge
KIU_EXTRA_CORS_ORIGINS=

KIU_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/kiu_lms
KIU_STORAGE_DRIVER=postgres
KIU_SINGLE_WRITER_MODE=true
KIU_MAX_FILE_UPLOAD_BYTES=26214400
KIU_ALLOW_LOCAL_PLATFORM_FALLBACK=false

KIU_MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000
KIU_MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
KIU_MICROSOFT_CLIENT_SECRET=replace-with-secret
KIU_MICROSOFT_REDIRECT_URI=https://portal-api.kiu.edu.ge/api/portal/microsoft/callback
KIU_MICROSOFT_TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

KIU_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
KIU_VAPID_PRIVATE_KEY=replace-with-vapid-private-key
KIU_WEB_PUSH_CONTACT=mailto:admin@kiu.edu.ge

KIU_AUTH_RATE_LIMIT_WINDOW_MS=600000
KIU_AUTH_RATE_LIMIT_MAX=20
KIU_RESET_RATE_LIMIT_WINDOW_MS=900000
KIU_RESET_RATE_LIMIT_MAX=10
KIU_AUDIT_RETENTION_DAYS=2555

KIU_FILE_STORAGE_MODE=external
KIU_ANTI_CHEAT_WINDOWS_URL=https://portal.kiu.edu.ge/downloads/anti-cheat-windows.exe
