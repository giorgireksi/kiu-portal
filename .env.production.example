KIU_ENVIRONMENT=production
NODE_ENV=production

# One public HTTPS origin is used by the portal, API, SSE, downloads, and clients.
KIU_PUBLIC_HOSTNAME=lms.youruniversity.edu
KIU_PUBLIC_APP_URL=https://lms.youruniversity.edu
KIU_PUBLIC_BACKEND_URL=https://lms.youruniversity.edu
KIU_PORTAL_LOGIN_URL=https://lms.youruniversity.edu/login.html
KIU_ALLOWED_DOMAINS=lms.youruniversity.edu
KIU_EXTRA_CORS_ORIGINS=

KIU_REALTIME_HOST=0.0.0.0
KIU_REALTIME_PORT=47833
KIU_TRUST_PROXY_HOPS=1
KIU_FILE_STORAGE_MODE=external
KIU_STORAGE_DRIVER=postgres
KIU_SINGLE_WRITER_MODE=true
KIU_MAX_FILE_UPLOAD_BYTES=26214400
KIU_ALLOW_LOCAL_PLATFORM_FALLBACK=false

# The Docker Compose postgres service reads these same values.
POSTGRES_DB=kiu_portal
POSTGRES_USER=kiu
POSTGRES_PASSWORD=replace-with-long-random-db-password
KIU_DATABASE_URL=postgres://kiu:replace-with-url-encoded-db-password@postgres:5432/kiu_portal
KIU_DATABASE_TABLE_NAME=kiu_platform_state_records

KIU_ADMIN_ID=admin-root
KIU_ADMIN_NAME=Portal Administrator
KIU_ADMIN_NAME_EN=Portal Administrator
KIU_ADMIN_DISPLAY_NAME=Portal Administrator
KIU_ADMIN_EMAIL=admin@youruniversity.edu
KIU_ADMIN_PASSWORD=replace-with-long-random-admin-password
KIU_ADMIN_FACULTY=

KIU_ANTI_CHEAT_APP_URL=https://lms.youruniversity.edu
KIU_ANTI_CHEAT_BACKEND_URL=https://lms.youruniversity.edu
KIU_ANTI_CHEAT_WINDOWS_URL=https://lms.youruniversity.edu/downloads/anti-cheat-windows.exe
KIU_ANTI_CHEAT_WINDOWS_PATH=
KIU_ANTI_CHEAT_ANDROID_URL=
KIU_ANTI_CHEAT_ANDROID_PATH=
KIU_ANTI_CHEAT_MACOS_URL=
KIU_ANTI_CHEAT_MACOS_PATH=
KIU_ANTI_CHEAT_LINUX_URL=
KIU_ANTI_CHEAT_LINUX_PATH=
KIU_ANTI_CHEAT_UPDATE_URL=

KIU_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
KIU_TURN_URLS=turn:turn.youruniversity.edu:3478?transport=udp,turn:turn.youruniversity.edu:3478?transport=tcp,turns:turn.youruniversity.edu:5349?transport=tcp
KIU_TURN_USERNAME=kiu-turn
KIU_TURN_CREDENTIAL=replace-with-long-random-turn-credential
KIU_TURN_REALM=youruniversity.edu
KIU_TURN_SERVER_NAME=turn.youruniversity.edu
KIU_TURN_EXTERNAL_IP=203.0.113.10
KIU_TURN_CERT_HOST_PATH=/etc/letsencrypt/live/turn.youruniversity.edu/fullchain.pem
KIU_TURN_KEY_HOST_PATH=/etc/letsencrypt/live/turn.youruniversity.edu/privkey.pem

KIU_MICROSOFT_TENANT_ID=common
KIU_MICROSOFT_CLIENT_ID=
KIU_MICROSOFT_CLIENT_SECRET=
KIU_MICROSOFT_REDIRECT_URI=https://lms.youruniversity.edu/api/portal/microsoft/callback
KIU_MICROSOFT_MAIL_REDIRECT_URI=https://lms.youruniversity.edu/api/mail/connect/callback
KIU_MICROSOFT_MAIL_SCOPE=offline_access openid profile email User.Read Mail.Read Mail.ReadWrite Mail.Send
KIU_MICROSOFT_TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

KIU_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
KIU_VAPID_PRIVATE_KEY=replace-with-vapid-private-key
KIU_WEB_PUSH_CONTACT=mailto:admin@youruniversity.edu
KIU_FIREBASE_PROJECT_ID=your-firebase-project-id
KIU_FIREBASE_SERVICE_ACCOUNT_FILE=/run/secrets/firebase-service-account.json
KIU_FIREBASE_SERVICE_ACCOUNT_HOST_PATH=/absolute/path/firebase-service-account.json

KIU_AUTH_RATE_LIMIT_WINDOW_MS=600000
KIU_AUTH_RATE_LIMIT_MAX=20
KIU_RESET_RATE_LIMIT_WINDOW_MS=900000
KIU_RESET_RATE_LIMIT_MAX=10
KIU_AUDIT_RETENTION_DAYS=2555
KIU_LOG_LEVEL=info

KIU_SIS_BASE_URL=
KIU_SIS_API_KEY=
KIU_FINANCE_BASE_URL=
KIU_FINANCE_API_KEY=
KIU_HR_BASE_URL=
KIU_HR_API_KEY=
KIU_CURRICULUM_BASE_URL=
KIU_CURRICULUM_API_KEY=
