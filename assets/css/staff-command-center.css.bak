}

body.lux-route-staff #staff-content .staff-dir-load-head,
body.lux-route-staff #staff-content .staff-dir-section-head,
body.lux-route-staff #staff-content .staff-dir-subject-head,
body.lux-route-staff #staff-content .staff-dir-schedule-head {
    display: flex !important;
    flex-wrap: wrap !important;
    align-items: flex-start !important;
    justify-content: space-between !important;
    gap: 10px !important;
}

body.lux-route-staff #staff-content .staff-dir-load-meta {
    margin-top: 0 !important;
    font-weight: 700 !important;
}

body.lux-route-staff #staff-content .staff-dir-load-summary,
body.lux-route-staff #staff-content .staff-dir-session-count {
    margin-top: 0 !important;
}

body.lux-route-staff #staff-content .staff-dir-load-meta.is-success {
    color: #76e6ae !important;
}

body.lux-route-staff #staff-content .staff-dir-load-meta.is-warning {
    color: #ffd1a4 !important;
}

body.lux-route-staff #staff-content .staff-dir-load-meta.is-danger {
    color: #ffd2d2 !important;
}

body.lux-route-staff #staff-content .staff-dir-progress,
body.lux-route-staff #staff-content .staff-dir-load-bar {
    height: 8px !important;
    overflow: hidden !important;
    border: 1px solid rgba(var(--lux-accent-rgb), .10) !important;
    border-radius: 999px !important;
    background: rgba(255, 255, 255, .08) !important;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .06) !important;
    display: block !important;
}

body.lux-route-staff #staff-content .staff-dir-progress-fill,
body.lux-route-staff #staff-content .staff-dir-load-bar > i {
    display: block !important;
    width: var(--staff-dir-progress, 0%) !important;
    height: 100% !important;
    border-radius: inherit !important;
    background: linear-gradient(90deg, var(--lux-accent), var(--lux-accent-2, var(--lux-accent))) !important;
    box-shadow: 0 0 18px rgba(var(--lux-accent-rgb), .28) !important;
}

body.lux-route-staff #staff-content .staff-dir-progress-fill.is-success,
body.lux-route-staff #staff-content .staff-dir-load-bar[data-staff-dir-load-tone='success'] > i {
    background: linear-gradient(90deg, #20c57c, #76e6ae) !important;
}

body.lux-route-staff #staff-content .staff-dir-progress-fill.is-warning,
body.lux-route-staff #staff-content .staff-dir-load-bar[data-staff-dir-load-tone='warning'] > i {
    background: linear-gradient(90deg, #f4a261, #ffd1a4) !important;
}

body.lux-route-staff #staff-content .staff-dir-progress-fill.is-danger,
body.lux-route-staff #staff-content .staff-dir-load-bar[data-staff-dir-load-tone='danger'] > i {
    background: linear-gradient(90deg, #f87171, #ffb4b4) !important;
}

body.lux-route-staff #staff-content .staff-dir-section {
    display: grid !important;
    gap: 10px !important;
}

body.lux-route-staff #staff-content .staff-dir-section-title {
    margin-bottom: 8px !important;
}

body.lux-route-staff #staff-content .staff-dir-subject-pills {
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 10px !important;
}

body.lux-route-staff #staff-content .staff-dir-schedule-count {
    margin-top: 0 !important;
}

body.lux-route-staff #staff-content .staff-dir-schedule-list,
body.lux-route-staff #staff-content .staff-dir-session-list {
    display: grid !important;
    gap: 8px !important;
}

body.lux-route-staff #staff-content .staff-dir-schedule-item,
body.lux-route-staff #staff-content .staff-dir-session-head {
    display: grid !important;
    gap: 6px !important;
}

body.lux-route-staff #staff-content .staff-dir-schedule-title,
body.lux-route-staff #staff-content .staff-dir-session-title {
    color: var(--lux-text) !important;
    font-size: 14px !important;
    font-weight: 700 !important;
    line-height: 1.35 !important;
}

body.lux-route-staff #staff-content .staff-dir-schedule-empty {
    color: var(--lux-text-muted) !important;
}

body.lux-route-staff #staff-content .staff-dir-stack-tight {
    display: grid !important;
    gap: 8px !important;
}

body.staff-dir-print,
body.staff-dir-print-page {
    margin: 0;
    background: #ffffff;
    color: #1f2933;
    font-family: "Segoe UI", Arial, sans-serif;
}

body.staff-dir-print .staff-dir-print-shell,
body.staff-dir-print-page .staff-dir-print-shell {
    max-width: 960px;
    margin: 0 auto;
    padding: 40px;
}

body.staff-dir-print .staff-dir-print-head,
body.staff-dir-print-page .staff-dir-print-head {
    display: grid;
    gap: 8px;
    margin-bottom: 32px;
    text-align: center;
}

body.staff-dir-print .staff-dir-print-hero,
body.staff-dir-print-page .staff-dir-print-hero {
    min-height: 0 !important;
}

body.staff-dir-print .staff-dir-print-kicker,
body.staff-dir-print-page .staff-dir-print-kicker {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: #4a5568;
}

body.staff-dir-print .staff-dir-print-title,
body.staff-dir-print-page .staff-dir-print-title {
    margin: 0;
    color: #102131;
    font-size: 30px;
    line-height: 1.1;
}

body.staff-dir-print .staff-dir-print-subtitle,
body.staff-dir-print-page .staff-dir-print-subtitle {
    margin: 0;
    color: #526070;
    font-size: 15px;
}

body.staff-dir-print .staff-dir-print-meta,
body.staff-dir-print-page .staff-dir-print-meta {
    display: grid;
    gap: 8px;
    margin: 0 0 24px;
}

body.staff-dir-print .staff-dir-print-meta-row,
body.staff-dir-print-page .staff-dir-print-meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

body.staff-dir-print .staff-dir-print-meta-label,
body.staff-dir-print-page .staff-dir-print-meta-label {
    font-weight: 700;
    color: #102131;
}

body.staff-dir-print .staff-dir-print-summary,
body.staff-dir-print-page .staff-dir-print-summary {
    display: grid !important;
    gap: 18px !important;
}

body.staff-dir-print .staff-dir-print-overline,
body.staff-dir-print-page .staff-dir-print-overline {
    color: #526070 !important;
}

body.staff-dir-print .staff-dir-print-badge,
body.staff-dir-print-page .staff-dir-print-badge {
    align-self: start;
}

body.staff-dir-print .staff-dir-print-rows,
body.staff-dir-print-page .staff-dir-print-rows {
    display: grid;
    gap: 12px;
}

body.staff-dir-print .staff-dir-print-row,
body.staff-dir-print-page .staff-dir-print-row {
    display: grid !important;
    grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    gap: 12px !important;
    align-items: stretch !important;
}

body.staff-dir-print .staff-dir-print-cell,
body.staff-dir-print-page .staff-dir-print-cell {
    display: grid;
    gap: 6px;
}

body.staff-dir-print .staff-dir-print-cell strong,
body.staff-dir-print-page .staff-dir-print-cell strong {
    color: #102131;
    font-size: 11px;
    letter-spacing: .05em;
    text-transform: uppercase;
}

body.staff-dir-print .staff-dir-print-cell small,
body.staff-dir-print-page .staff-dir-print-cell small {
    color: #526070;
    font-size: 13px;
}

body.staff-dir-print .staff-dir-print-table,
body.staff-dir-print-page .staff-dir-print-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
}

body.staff-dir-print .staff-dir-print-table th,
body.staff-dir-print .staff-dir-print-table td,
body.staff-dir-print-page .staff-dir-print-table th,
body.staff-dir-print-page .staff-dir-print-table td {
    border: 1px solid #d6dde5;
    padding: 10px 12px;
    text-align: left;
}

body.staff-dir-print .staff-dir-print-table th,
body.staff-dir-print-page .staff-dir-print-table th {
    background: #f4f6f8;
    font-size: 12px;
    letter-spacing: .04em;
    text-transform: uppercase;
}

body.staff-dir-print .staff-dir-print-summary-stat,
body.staff-dir-print-page .staff-dir-print-summary-stat {
    margin-top: 20px;
    font-size: 15px;
    font-weight: 700;
    color: #102131;
}

body.staff-dir-print .staff-dir-print-stamp-wrap,
body.staff-dir-print-page .staff-dir-print-stamp-wrap {
    margin-top: 24px;
    text-align: center;
}

body.staff-dir-print .staff-dir-print-stamp,
body.staff-dir-print-page .staff-dir-print-stamp {
    display: inline-block;
    padding: 10px 14px;
    border: 3px solid #c73f34;
    color: #c73f34;
    font-size: 14px;
    font-weight: 900;
    letter-spacing: .04em;
    text-transform: uppercase;
    transform: rotate(-15deg);
}

@media print {
    body.staff-dir-print .staff-dir-print-shell,
    body.staff-dir-print-page .staff-dir-print-shell {
        padding: 0;
    }
}

body.lux-route-staff #staff-name-geo:focus,
body.lux-route-staff #staff-name-en:focus {
    border-color: var(--kiu-blue) !important;
    box-shadow: 0 0 0 3px rgba(10,132,255,0.1);
}

/* Staff route compatibility layer migrated out of index-luxury.css so staff visuals are route-owned. */
body.lux-route-staff #staff-content,
body.lux-entry-admin-orders #admin-orders-root {
    position: relative;
    z-index: 1;
}

body.lux-route-staff .lux-page-shell {
    display: grid;
    gap: 18px;
}

body.lux-route-staff .page-hero {
    background:
        radial-gradient(circle at 84% 18%, rgba(var(--lux-accent-rgb), 0.14), transparent 28%),
        radial-gradient(circle at 12% 100%, rgba(var(--lux-home-secondary-rgb), 0.10), transparent 24%),
        linear-gradient(180deg, rgba(12, 18, 31, 0.90), rgba(8, 12, 20, 0.96)) !important;
    border: 1px solid rgba(255, 255, 255, 0.08) !important;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.30) !important;
}

body.lux-route-staff .page-hero::before {
    background:
        linear-gradient(120deg, rgba(255, 255, 255, 0.04), transparent 42%),
        radial-gradient(circle at 80% 18%, rgba(var(--lux-accent-rgb), 0.10), transparent 26%) !important;
}

body.lux-route-staff .page-hero-title {
    max-width: 12ch;
}

body.lux-route-staff .page-hero-copy {
    max-width: 860px;
}

body.lux-route-staff .page-hero-badge {
    background: rgba(255, 255, 255, 0.05) !important;
    border-color: rgba(255, 255, 255, 0.10) !important;
}

body.lux-route-staff .lux-card,
body.lux-route-staff .lux-person-card,
body.lux-route-staff .lux-subcard {
    background:
        radial-gradient(circle at top right, rgba(var(--lux-accent-rgb), 0.06), transparent 30%),
        linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.03)) !important;
    border-color: rgba(255, 255, 255, 0.08) !important;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.24) !important;
}

body.lux-route-staff .lux-person-card {
    border-radius: 26px;
    padding: 20px;
    min-width: 0;
    overflow: hidden;
}

body.lux-route-staff .lux-person-head,
body.lux-route-staff .lux-person-head > div,
body.lux-route-staff .lux-subcard,
body.lux-route-staff .lux-subcard > div,
body.lux-route-staff .lux-actions-between,
body.lux-route-staff .lux-actions-between > div,
body.lux-route-staff .lux-card-actions,
body.lux-route-staff .lux-card-actions > *,
body.lux-route-staff .lux-inline-meta,
body.lux-route-staff .lux-inline-meta span {
    min-width: 0;
}

body.lux-route-staff .lux-person-name,
body.lux-route-staff .lux-card-title,
body.lux-route-staff .lux-card-copy,
body.lux-route-staff .lux-meta,
body.lux-route-staff .lux-overline,
body.lux-route-staff .lux-subcard,
body.lux-route-staff .lux-subcard *:not(i),
body.lux-route-staff .page-hero-title,
body.lux-route-staff .page-hero-copy,
body.lux-route-staff .page-hero-badge {
    overflow-wrap: anywhere;
    word-break: break-word;
}

body.lux-route-staff .lux-person-name {
    font-weight: 800;
    line-height: 1.2;
}

body.lux-route-staff .lux-inline-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 14px;
}

body.lux-route-staff .lux-inline-meta span {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
}

body.lux-route-staff .lux-card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

body.lux-route-staff .lux-card-actions > * {
    flex: 0 1 auto;
    max-width: 100%;
}

body.lux-route-staff .lux-actions-between {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 14px;
    align-items: center;
    justify-content: space-between;
}

body.lux-route-staff .lux-empty-state {
    background: rgba(255, 255, 255, 0.04) !important;
    border-color: rgba(255, 255, 255, 0.10) !important;
}

body.lux-route-staff .staff-tabs {
    gap: 12px;
}

body.lux-route-staff .staff-tabs .lux-picker-btn {
    flex: 1 1 220px;
    min-width: 0;
}

body.lux-route-staff .staff-tabs .lux-picker-btn strong {
    font-size: 13px;
}

body.lux-route-staff .staff-tabs .lux-picker-btn i {
    font-size: 12px;
}

body.lux-route-staff .kiu-btn-blue {
    box-shadow: 0 18px 36px rgba(var(--lux-accent-rgb), 0.22) !important;
}

body.lux-route-staff .page-hero,
body.lux-route-staff .lux-card,
body.lux-route-staff .lux-person-card,
body.lux-route-staff .lux-empty-state {
    background:
        radial-gradient(circle at 8% 0%, rgba(255, 255, 255, calc(var(--lux-transparency-alpha, .92) * .075)), transparent 32%),
        radial-gradient(circle at 72% 0%, rgba(var(--lux-accent-rgb), calc(var(--lux-transparency-alpha, .92) * .24)), transparent 38%),
        radial-gradient(circle at 100% 94%, rgba(var(--lux-home-secondary-rgb), calc(var(--lux-transparency-alpha, .92) * .14)), transparent 38%),
        linear-gradient(135deg, rgba(var(--lux-accent-rgb), calc(var(--lux-transparency-alpha, .92) * .10)), rgba(10, 15, 24, calc(var(--lux-transparency-alpha, .92) * .91)) 44%, rgba(7, 10, 18, calc(var(--lux-transparency-alpha, .92) * .84))) !important;
    border-color: rgba(var(--lux-accent-rgb), .16) !important;
    box-shadow: 0 24px 58px rgba(0, 0, 0, .24), inset 0 1px 0 rgba(255, 255, 255, .08) !important;
    backdrop-filter: blur(var(--lux-transparency-blur, 18px)) saturate(var(--lux-transparency-saturate, 145%)) !important;
    -webkit-backdrop-filter: blur(var(--lux-transparency-blur, 18px)) saturate(var(--lux-transparency-saturate, 145%)) !important;
}

body.lux-route-staff .lux-subcard,
body.lux-route-staff .lux-person-head,
body.lux-route-staff .staff-tabs .lux-picker-btn,
body.lux-route-staff .lux-inline-meta,
body.lux-route-staff .prof-reg-info-box {
    background:
        radial-gradient(circle at 12% 0%, rgba(255, 255, 255, calc(var(--lux-transparency-alpha, .92) * .055)), transparent 30%),
        radial-gradient(circle at 84% 0%, rgba(var(--lux-accent-rgb), calc(var(--lux-transparency-alpha, .92) * .14)), transparent 34%),
        linear-gradient(135deg, rgba(var(--lux-accent-rgb), calc(var(--lux-transparency-alpha, .92) * .065)), rgba(10, 15, 24, calc(var(--lux-transparency-alpha, .92) * .88)) 46%, rgba(7, 10, 18, calc(var(--lux-transparency-alpha, .92) * .80))) !important;
    border-color: rgba(var(--lux-accent-rgb), .12) !important;
    box-shadow: 0 14px 32px rgba(0, 0, 0, .18), inset 0 1px 0 rgba(255, 255, 255, .06) !important;
    backdrop-filter: blur(var(--lux-transparency-blur, 18px)) saturate(var(--lux-transparency-saturate, 145%)) !important;
    -webkit-backdrop-filter: blur(var(--lux-transparency-blur, 18px)) saturate(var(--lux-transparency-saturate, 145%)) !important;
}

body.lux-light-mode.lux-route-staff .page-hero,
body.lux-light-mode.lux-route-staff .lux-card,
body.lux-light-mode.lux-route-staff .lux-person-card,
body.lux-light-mode.lux-route-staff .lux-empty-state {
    background:
        radial-gradient(circle at 8% 0%, rgba(255, 255, 255, calc(var(--lux-transparency-alpha, .86) * .88)), transparent 34%),
        radial-gradient(circle at 72% 0%, rgba(var(--lux-accent-rgb), calc(var(--lux-transparency-alpha, .86) * .22)), transparent 38%),
        radial-gradient(circle at 100% 94%, rgba(var(--lux-home-secondary-rgb), calc(var(--lux-transparency-alpha, .86) * .13)), transparent 38%),
        linear-gradient(135deg, rgba(var(--lux-accent-rgb), calc(var(--lux-transparency-alpha, .86) * .075)), rgba(255, 255, 255, calc(var(--lux-transparency-alpha, .86) * .88)) 44%, rgba(247, 241, 232, calc(var(--lux-transparency-alpha, .86) * .72))) !important;
    border-color: rgba(var(--lux-accent-rgb), .14) !important;
    box-shadow: 0 22px 48px rgba(var(--lux-glass-tint-rgb, 15, 23, 42), .12), inset 0 1px 0 rgba(255, 255, 255, .68) !important;
}

body.lux-light-mode.lux-route-staff .lux-subcard,
body.lux-light-mode.lux-route-staff .lux-person-head,
body.lux-light-mode.lux-route-staff .staff-tabs .lux-picker-btn,
body.lux-light-mode.lux-route-staff .lux-inline-meta,
body.lux-light-mode.lux-route-staff .prof-reg-info-box {
    background:
        radial-gradient(circle at 10% 0%, rgba(255, 255, 255, calc(var(--lux-transparency-alpha, .86) * .78)), transparent 32%),
        radial-gradient(circle at 84% 0%, rgba(var(--lux-accent-rgb), calc(var(--lux-transparency-alpha, .86) * .14)), transparent 34%),
        linear-gradient(135deg, rgba(var(--lux-accent-rgb), calc(var(--lux-transparency-alpha, .86) * .055)), rgba(255, 255, 255, calc(var(--lux-transparency-alpha, .86) * .82)) 46%, rgba(247, 241, 232, calc(var(--lux-transparency-alpha, .86) * .66))) !important;
    border-color: rgba(var(--lux-accent-rgb), .11) !important;
    box-shadow: 0 14px 30px rgba(var(--lux-glass-tint-rgb, 15, 23, 42), .10), inset 0 1px 0 rgba(255, 255, 255, .62) !important;
}

body.lux-route-staff .admin-hero-metrics,
body.lux-route-staff .admin-summary-grid {
    display: grid !important;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)) !important;
    gap: 12px !important;
}

body.lux-route-staff .admin-hero-metrics article {
    min-width: 0 !important;
    padding: 18px !important;
    border: 1px solid rgba(var(--lux-accent-rgb), 0.18) !important;
    border-radius: 20px !important;
    background:
        radial-gradient(circle at 88% 0%, rgba(var(--lux-accent-rgb), calc(var(--lux-transparency-alpha, .92) * .18)), transparent 36%),
        rgba(7, 10, 18, calc(var(--lux-transparency-alpha, .92) * .44)) !important;
}

body.lux-route-staff .admin-hero-metrics span,
body.lux-route-staff .admin-mini-grid span {
    display: block !important;
    color: var(--lux-text-muted) !important;
    font-size: 11px !important;
    font-weight: 800 !important;
    letter-spacing: .06em !important;
    line-height: 1.25 !important;
    text-transform: uppercase !important;
}

body.lux-route-staff .admin-hero-metrics strong {
    display: block !important;
    margin-top: 8px !important;
    color: var(--lux-text) !important;
    font-size: clamp(22px, 3vw, 38px) !important;
    line-height: 1 !important;
}

body.lux-route-staff .admin-directory-filter-grid {
    grid-template-columns: minmax(260px, 1.4fr) repeat(2, minmax(190px, .8fr)) !important;
    gap: 14px !important;
    margin-top: 18px !important;
}

body.lux-route-staff .admin-record-strip,
body.lux-route-staff .admin-saved-views {
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 8px !important;
}

body.lux-route-staff .admin-saved-views {
    margin: 18px 0 !important;
}

body.lux-route-staff .admin-saved-views button {
    min-height: 36px !important;
    padding: 8px 14px !important;
    border: 1px solid rgba(var(--lux-accent-rgb), 0.18) !important;
    border-radius: 999px !important;
    background: rgba(255, 255, 255, calc(var(--lux-transparency-alpha, .92) * .05)) !important;
    color: var(--lux-text) !important;
    font-size: 12px !important;
    font-weight: 800 !important;
    cursor: pointer !important;
}

body.lux-route-staff .admin-saved-views button:hover {
    border-color: rgba(var(--lux-accent-rgb), 0.34) !important;
    transform: translateY(-1px) !important;
}

body.lux-route-staff .admin-mini-grid {
    display: grid !important;
    grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    gap: 10px !important;
}

body.lux-route-staff .admin-mini-grid > div {
    min-width: 0 !important;
    padding: 14px !important;
    border: 1px solid rgba(var(--lux-accent-rgb), 0.15) !important;
    border-radius: 16px !important;
    background: rgba(255, 255, 255, calc(var(--lux-transparency-alpha, .92) * .045)) !important;
}

body.lux-route-staff .admin-mini-grid strong {
    display: block !important;
    color: var(--lux-text) !important;
    font-size: 20px !important;
    line-height: 1.05 !important;
}

body.lux-route-staff .admin-table-head {
    margin: 0 0 18px !important;
}

body.lux-route-staff .admin-table-scroll {
    width: 100% !important;
    overflow-x: auto !important;
    border: 1px solid rgba(var(--lux-accent-rgb), 0.12) !important;
    border-radius: 22px !important;
}

body.lux-route-staff .lux-danger-btn {
    color: #ffd2d2 !important;
    border-color: rgba(248, 113, 113, .36) !important;
}

body.lux-light-mode.lux-route-staff .admin-hero-metrics article,
html.lux-light-mode body.lux-route-staff .admin-hero-metrics article,
body.lux-light-mode.lux-route-staff .admin-mini-grid > div,
html.lux-light-mode body.lux-route-staff .admin-mini-grid > div,
body.lux-light-mode.lux-route-staff .admin-saved-views button,
html.lux-light-mode body.lux-route-staff .admin-saved-views button {
    background: rgba(255, 255, 255, calc(var(--lux-transparency-alpha, .86) * .62)) !important;
}

@media (max-width: 1120px) {
    body.lux-route-staff .admin-directory-filter-grid,
    body.lux-route-staff .staff-tabs {
        grid-template-columns: 1fr !important;
    }
}
