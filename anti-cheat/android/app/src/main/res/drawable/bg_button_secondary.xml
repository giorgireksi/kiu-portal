<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="@color/anti_cheat_panel_alt" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/anti_cheat_border" />
            <stroke
                android:width="1dp"
                android:color="@color/anti_cheat_accent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/anti_cheat_panel_alt" />
            <stroke
                android:width="1dp"
                android:color="@color/anti_cheat_border" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
