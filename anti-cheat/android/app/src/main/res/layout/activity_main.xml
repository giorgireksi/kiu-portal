<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/anti_cheat_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/app_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="@string/app_name"
        android:textColor="@color/anti_cheat_text"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/status_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@color/anti_cheat_panel_alt"
        android:padding="12dp"
        android:textColor="@color/anti_cheat_text"
        android:visibility="gone" />

    <TextView
        android:id="@+id/security_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="#2A1111"
        android:padding="12dp"
        android:textColor="#FCA5A5"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/controls_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/login_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/anti_cheat_panel"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingBottom="8dp"
                    android:text="@string/login_heading"
                    android:textColor="@color/anti_cheat_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/email_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="University email"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    android:padding="12dp"
                    android:textColor="@color/anti_cheat_text"
                    android:textColorHint="@color/anti_cheat_text_muted" />

                <EditText
                    android:id="@+id/password_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Password"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:padding="12dp"
                    android:textColor="@color/anti_cheat_text"
                    android:textColorHint="@color/anti_cheat_text_muted" />

                <Button
                    android:id="@+id/login_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Sign in" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/launcher_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/anti_cheat_panel"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingBottom="8dp"
                    android:text="@string/launcher_heading"
                    android:textColor="@color/anti_cheat_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/user_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/anti_cheat_text" />

                <TextView
                    android:id="@+id/role_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@color/anti_cheat_panel_alt"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:textColor="@color/anti_cheat_text"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/session_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/anti_cheat_text_muted" />

                <TextView
                    android:id="@+id/policy_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/anti_cheat_text_muted" />

                <Button
                    android:id="@+id/open_lms_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Open LMS" />

                <Button
                    android:id="@+id/open_exam_portal_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Open Exam Portal" />

                <Button
                    android:id="@+id/system_check_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="System Check" />

                <Button
                    android:id="@+id/clear_cache_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Clear Cache" />

                <Button
                    android:id="@+id/refresh_session_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Refresh Session" />

                <Button
                    android:id="@+id/logout_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Sign Out" />

                <LinearLayout
                    android:id="@+id/staff_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@color/anti_cheat_panel_alt"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingBottom="8dp"
                        android:text="@string/staff_heading"
                        android:textColor="@color/anti_cheat_text"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/config_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/anti_cheat_text_muted" />

                    <EditText
                        android:id="@+id/staff_url_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="Open a URL"
                        android:inputType="textUri"
                        android:padding="12dp"
                        android:textColor="@color/anti_cheat_text"
                        android:textColorHint="@color/anti_cheat_text_muted" />

                    <Button
                        android:id="@+id/staff_open_url_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Open URL" />

                    <TextView
                        android:id="@+id/staff_diagnostics_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/anti_cheat_text_muted" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/blocked_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#2A1111"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingBottom="8dp"
                    android:text="@string/blocked_heading"
                    android:textColor="#FCA5A5"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/blocked_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FCA5A5" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/web_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <WebView
            android:id="@+id/webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>
</LinearLayout>
