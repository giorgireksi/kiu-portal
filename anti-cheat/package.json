{
  "name": "anti-cheat",
  "version": "1.0.0",
  "description": "Secure anti-cheat browser for online quizzes",
  "main": "dist/main.js",
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc && node -e \"const fs=require('fs'); fs.cpSync('src/ui','dist/ui',{recursive:true}); fs.copyFileSync('src/config.json','dist/config.json');\"",
    "postinstall": "node scripts/ensure-electron-platform.js",
    "prestart": "npm run build && node scripts/ensure-electron-platform.js",
    "start": "node node_modules/electron/cli.js .",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "Anti-Cheat Pro",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "electron": "^41.2.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "axios": "^1.15.0",
    "bonjour-service": "^1.3.0",
    "crypto-js": "^4.2.0",
    "electron-squirrel-startup": "^1.0.1",
    "express": "^5.2.1"
  }
}
