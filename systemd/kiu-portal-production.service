[Unit]
Description=KIU Portal self-hosted production stack
Wants=network-online.target docker.service tailscaled.service
After=network-online.target docker.service tailscaled.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=@KIU_ROOT@
Environment=KIU_DOCKER_BIN=@DOCKER_BIN@
Environment=DOCKER_CONFIG=@DOCKER_CONFIG@
ExecStart=@KIU_ROOT@/start-selfhosted-production.sh
ExecStop=@KIU_ROOT@/stop-selfhosted-production.sh
TimeoutStartSec=0
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
