[Unit]
Description=KIU Portal PostgreSQL and uploads backup
Requires=kiu-portal-production.service
After=kiu-portal-production.service

[Service]
Type=oneshot
WorkingDirectory=@KIU_ROOT@
Environment=KIU_DOCKER_BIN=@DOCKER_BIN@
Environment=DOCKER_CONFIG=@DOCKER_CONFIG@
ExecStart=@KIU_ROOT@/scripts/backup-production.sh @KIU_ROOT@/backups
